<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Geometry resources for nav icons -->
  <Geometry x:Key="Geo_Dashboard">M3,3 H9 V9 H3 Z M11,3 H17 V11 H11 Z M19,3 H21 V7 H19 Z</Geometry>
  <Geometry x:Key="Geo_Optimize">M12,2 L13.6,5.4 L17,6.6 L14,9 L14.6,12 L12,11 L9.4,12 L10,9 L7,6.6 L10.4,5.4 Z</Geometry>
  <Geometry x:Key="Geo_Library">M3,4 H9 V20 H3 Z M11,4 H17 V20 H11 Z</Geometry>
  <Geometry x:Key="Geo_Api">M6,2 H10 V8 H6 Z M14,2 H18 V8 H14 Z M6,8 V20 H18 V8 Z</Geometry>
  <Geometry x:Key="Geo_Settings">M12,2 L13.6,5.4 L17,6.6 L14,9 L14.6,12 L12,11 L9.4,12 L10,9 L7,6.6 L10.4,5.4 Z</Geometry>
  <Geometry x:Key="Geo_Diagnostics">M10,6 A4,4 0 1 0 10,14 A4,4 0 1 0 10,6 Z M15,14 L20,19</Geometry>
  <Geometry x:Key="Geo_Market">M4,16 L8,8 L12,14 L16,6 L20,12</Geometry>
  <Geometry x:Key="Geo_Trading">M4,4 H20 V8 H4 Z M4,10 H20 V20 H4 Z</Geometry>
  <Geometry x:Key="Geo_Performance">M4,18 L8,10 L12,14 L16,8 L20,12</Geometry>
  <Geometry x:Key="Geo_Account">M6,4 A4,4 0 1 0 6,12 A4,4 0 1 0 6,4 Z M12,6 H20 V10 H12 Z</Geometry>
  <Geometry x:Key="Geo_Alert">M12,3 L3,19 H21 Z</Geometry>

  <!-- Backwards compatible DrawingBrushes -->
  <DrawingBrush x:Key="IconDashboard">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource Geo_Dashboard}" />
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <DrawingBrush x:Key="IconOptimize">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource Geo_Optimize}" />
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <DrawingBrush x:Key="IconLibrary">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource Geo_Library}" />
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <DrawingBrush x:Key="IconApi">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource Geo_Api}" />
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <DrawingBrush x:Key="IconMarket">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource Geo_Market}" />
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <DrawingBrush x:Key="IconTrading">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource Geo_Trading}" />
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <DrawingBrush x:Key="IconPerformance">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource Geo_Performance}" />
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <DrawingBrush x:Key="IconAccount">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource Geo_Account}" />
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <DrawingBrush x:Key="IconAlert">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource Geo_Alert}" />
    </DrawingBrush.Drawing>
  </DrawingBrush>

</ResourceDictionary>
