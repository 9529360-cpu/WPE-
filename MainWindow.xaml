<Window x:Class="币安量化机器人.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:币安量化机器人.Models"
        xmlns:conv="clr-namespace:币安量化机器人.Converters"
        xmlns:ctrl="clr-namespace:币安量化机器人.Controls"
        Title="Alpha Arena · 量化交易终端"
        MinWidth="1200" MinHeight="800"
        FontFamily="Microsoft YaHei"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:NotNullToCollapsedConverter x:Key="NotNullToCollapsedConverter" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Alpha Arena 智能量化终端" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Collapse nav -->
                    <ToggleButton x:Name="NavCollapseToggle" Width="36" Height="28" Margin="0,0,8,0" Click="NavCollapseToggle_Click">≡</ToggleButton>
                    <TextBlock Text="💎 专业版" Foreground="{StaticResource WarningBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="帮助" Margin="0,0,0,0" Height="28" MinWidth="72"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 精简左侧菜单 -->
        <Border Grid.Row="1" Grid.Column="0" Margin="8,8,12,8" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
            <Border.Resources>
                <Style x:Key="NavLabelStyle" TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavCollapseToggle}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="IconPathStyle" TargetType="Path">
                    <Setter Property="Stretch" Value="Uniform"/>
                    <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                </Style>

                <Style x:Key="CondensedNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Height" Value="44"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="8">
                                    <Grid>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="核心功能" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

                    <!-- Navigation bound list -->
                    <ItemsControl x:Name="NavItemsControl" ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NavMenuItem}">
                                <Button Tag="{Binding Tag}" Height="44" Margin="0,4,0,0" Click="NavButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                                            <ctrl:Icon Geometry="{Binding GeometryData}" Fill="{Binding Icon, FallbackValue={StaticResource IconDashboard}}" Width="20" Height="20"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource NavLabelStyle}" Text="{Binding Title}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=NavCollapseToggle}" Value="True">
                                                    <Setter Property="Template" Value="{StaticResource CondensedNavButton}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>

                    <Separator Margin="0,8,0,12"/>

                    <!-- 提示信息 -->
                    <Border Background="#DBEAFE" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="💡 使用提示" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#1E3A8A" LineHeight="16">
                                • 仪表盘已集成日常交易所需的所有核心功能
                                <LineBreak/>
                                • 点击仪表盘内的Tab标签页快速切换子模块
                                <LineBreak/>
                                • 独立工具适用于深度分析和系统配置
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Row="1" Grid.Column="1" Margin="0,8,0,8" BorderBrush="{StaticResource BorderBrushValue}" BorderThickness="1" CornerRadius="8" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" Padding="8">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="SectionTitle" Text="欢迎使用 Alpha Arena · 请选择功能" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" x:Name="MainContentHost" Background="{StaticResource SurfaceBrush}">
                    <!-- 默认欢迎界面 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" Margin="20">
                        <TextBlock Text="🚀" FontSize="64" TextAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="欢迎使用 Alpha Arena" FontSize="24" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="点击左侧「仪表盘」开始使用完整功能" FontSize="15" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="24"/>
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="20" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="✨ 仪表盘包含:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="• AI 智能交易中心 - 自动分析与决策" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="• 实时行情监控 - WebSocket 推送" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="• 绩效分析仪表盘 - 全面统计" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="• 快捷交易面板 - 一键下单" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="• 系统设置管理 - API配置" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource CardBackgroundBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：就绪 · 准备启动量化交易"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🟢" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="系统运行正常 · © Alpha Arena v2.0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
