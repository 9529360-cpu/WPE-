<Window x:Class="币安量化机器人.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha Arena · 量化交易终端"
        MinWidth="1200" MinHeight="800"
        FontFamily="Microsoft YaHei"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#243B4A" CornerRadius="8" Padding="12">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Alpha Arena 智能量化终端"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="💎 专业版" Foreground="#FCD34D" FontSize="13" FontWeight="Bold" 
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="帮助" Margin="0,0,0,0" Height="28" MinWidth="72"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 精简左侧菜单 -->
        <Border Grid.Row="1" Grid.Column="0" Margin="8,8,12,8" Background="#F3F5F7" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="核心功能" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

                    <!-- 🚀 仪表盘 (主推荐) -->
                    <Button Content="🚀 仪表盘" Tag="仪表盘" Margin="0,0,0,8" Height="56" 
                            Click="NavButton_Click" 
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="16">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <TextBlock Text="📌 仪表盘包含: AI中心、行情、绩效、交易、设置" 
                               FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" 
                               Margin="4,0,0,12" LineHeight="16"/>

                    <Separator Margin="0,8,0,12"/>
                    
                    <!-- 独立功能模块 -->
                    <TextBlock Text="进阶工具" FontWeight="SemiBold" FontSize="13" Foreground="#6B7280" Margin="0,0,0,8"/>

                    <Button Content="🧬 参数优化" Tag="参数优化" Margin="0,4,0,0" Height="38" Click="NavButton_Click"/>
                    <Button Content="📚 策略库" Tag="策略库" Margin="0,4,0,0" Height="38" Click="NavButton_Click"/>
                    <Button Content="🎛️ 策略组合" Tag="组合管理" Margin="0,4,0,0" Height="38" Click="NavButton_Click"/>

                    <Separator Margin="0,12,0,12"/>
                    
                    <!-- 系统管理 -->
                    <TextBlock Text="系统管理" FontWeight="SemiBold" FontSize="13" Foreground="#6B7280" Margin="0,0,0,8"/>

                    <Button Content="🔑 API 管理" Tag="API" Margin="0,4,0,0" Height="38" Click="NavButton_Click"
                            Background="#FEF3C7" Foreground="#92400E" FontWeight="SemiBold"/>
                    <Button Content="🛠 系统配置" Tag="设置" Margin="0,4,0,0" Height="38" Click="NavButton_Click"/>
                    <Button Content="🧾 日志诊断" Tag="诊断" Margin="0,4,0,0" Height="38" Click="NavButton_Click"/>

                    <Separator Margin="0,12,0,12"/>

                    <!-- 提示信息 -->
                    <Border Background="#DBEAFE" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="💡 使用提示" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#1E3A8A" LineHeight="16">
                                • 仪表盘已集成日常交易所需的所有核心功能
                                <LineBreak/>
                                • 点击仪表盘内的Tab标签页快速切换子模块
                                <LineBreak/>
                                • 独立工具适用于深度分析和系统配置
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Row="1" Grid.Column="1" Margin="0,8,0,8"
                BorderBrush="#E1E6EB" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F8FAFB" Padding="8">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="SectionTitle" Text="欢迎使用 Alpha Arena · 请选择功能"
                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" x:Name="MainContentHost" Background="White">
                    <!-- 默认欢迎界面 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                                MaxWidth="500" Margin="20">
                        <TextBlock Text="🚀" FontSize="64" TextAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="欢迎使用 Alpha Arena" 
                                   FontSize="24" FontWeight="Bold" TextAlignment="Center"
                                   Foreground="#111827" Margin="0,0,0,12"/>
                        <TextBlock Text="点击左侧「仪表盘」开始使用完整功能" 
                                   FontSize="15" TextAlignment="Center" Foreground="#6B7280"
                                   TextWrapping="Wrap" LineHeight="24"/>
                        <Border Background="#F3F4F6" CornerRadius="8" Padding="20" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="✨ 仪表盘包含:" FontWeight="Bold" FontSize="13" 
                                           Foreground="#374151" Margin="0,0,0,10"/>
                                <TextBlock Text="• AI 智能交易中心 - 自动分析与决策" FontSize="12" 
                                           Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBlock Text="• 实时行情监控 - WebSocket 推送" FontSize="12" 
                                           Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBlock Text="• 绩效分析仪表盘 - 全面统计" FontSize="12" 
                                           Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBlock Text="• 快捷交易面板 - 一键下单" FontSize="12" 
                                           Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBlock Text="• 系统设置管理 - API配置" FontSize="12" 
                                           Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Background="#F3F5F7">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：就绪 · 准备启动量化交易"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🟢" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="系统运行正常 · © Alpha Arena v2.0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
