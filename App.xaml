<Application x:Class="币安量化机器人.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:币安量化机器人.Models"
             xmlns:conv="clr-namespace:币安量化机器人.Converters"
             xmlns:ctrl="clr-namespace:币安量化机器人.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <!-- Ensure control styles are loaded at application startup -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Control styles are centralized in Themes/Controls.xaml -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
