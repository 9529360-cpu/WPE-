<UserControl x:Class="币安量化机器人.Modules.Strategy.StrategyPortfolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400">
    
    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="24,20" 
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🎛️" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="多策略组合管理" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock x:Name="StatusText" Text="统一管理多个交易策略" 
                                   FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 组合统计 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                           HorizontalAlignment="Center" Margin="40,0">
                    <!-- 总收益率 -->
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="组合收益" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PortfolioReturnText" Text="0%" 
                                       FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 夏普比率 -->
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="夏普比率" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PortfolioSharpeText" Text="0.00" 
                                       FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 运行中策略 -->
                    <Border Background="#FEF3C7" CornerRadius="8" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="运行中" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RunningCountText" Text="0/0" 
                                       FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="AddButton" Content="➕ 添加策略" 
                            Width="110" Height="36" Margin="0,0,8,0"
                            Background="#10B981" Foreground="White"
                            BorderThickness="0"
                            FontSize="13" FontWeight="Bold"
                            Click="Add_Click"/>
                    
                    <Button x:Name="BalanceButton" Content="⚖️ 平衡权重" 
                            Width="110" Height="36" Margin="0,0,8,0"
                            Background="#F3F4F6" Foreground="#374151"
                            BorderBrush="#D1D5DB" BorderThickness="1"
                            FontSize="13" FontWeight="SemiBold"
                            Click="Balance_Click"/>
                    
                    <Button x:Name="RefreshButton" Content="🔄 刷新" 
                            Width="90" Height="36"
                            Background="#3B82F6" Foreground="White"
                            BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold"
                            Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!-- 策略列表 -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" 
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 列表标题 -->
                    <Border Grid.Row="0" Background="#F9FAFB" Padding="20,16"
                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="📊 策略列表" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock x:Name="StrategyCountText" Text="(0 个策略)" 
                                       FontSize="13" Foreground="#6B7280"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 策略表格 -->
                    <DataGrid x:Name="StrategiesGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="60"
                              Background="Transparent"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <!-- 状态 -->
                            <DataGridTemplateColumn Header="状态" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" 
                                                CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding StatusText}" 
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 策略名称 -->
                            <DataGridTextColumn Header="策略名称" Width="180" Binding="{Binding Name}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#111827"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 类型 -->
                            <DataGridTextColumn Header="类型" Width="120" Binding="{Binding Type}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 权重 -->
                            <DataGridTemplateColumn Header="资金权重" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding WeightText}" 
                                                       FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                            <ProgressBar Value="{Binding WeightPercent, Mode=OneWay}" 
                                                         Height="4" Margin="0,4,0,0"
                                                         Foreground="#3B82F6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 收益率 -->
                            <DataGridTextColumn Header="总收益率" Width="100" Binding="{Binding ReturnText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 夏普比率 -->
                            <DataGridTextColumn Header="夏普比率" Width="100" Binding="{Binding SharpeText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#111827"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 交易次数 -->
                            <DataGridTextColumn Header="交易次数" Width="100" Binding="{Binding TradesText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 胜率 -->
                            <DataGridTextColumn Header="胜率" Width="80" Binding="{Binding WinRateText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#10B981"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 运行时间 -->
                            <DataGridTextColumn Header="运行时间" Width="100" Binding="{Binding RunningTimeText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 操作 -->
                            <DataGridTemplateColumn Header="操作" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="▶️" Tag="{Binding Id}" 
                                                    Width="40" Height="32" Margin="0,0,4,0"
                                                    Background="#10B981" Foreground="White"
                                                    BorderThickness="0" FontSize="14"
                                                    Click="Start_Click"
                                                    ToolTip="启动策略"/>
                                            <Button Content="⏹️" Tag="{Binding Id}"
                                                    Width="40" Height="32" Margin="0,0,4,0"
                                                    Background="#EF4444" Foreground="White"
                                                    BorderThickness="0" FontSize="14"
                                                    Click="Stop_Click"
                                                    ToolTip="停止策略"/>
                                            <Button Content="⚙️" Tag="{Binding Id}"
                                                    Width="40" Height="32" Margin="0,0,4,0"
                                                    Background="#3B82F6" Foreground="White"
                                                    BorderThickness="0" FontSize="14"
                                                    Click="Edit_Click"
                                                    ToolTip="编辑策略"/>
                                            <Button Content="🗑️" Tag="{Binding Id}"
                                                    Width="40" Height="32"
                                                    Background="#F3F4F6" Foreground="#EF4444"
                                                    BorderBrush="#E5E7EB" BorderThickness="1" FontSize="14"
                                                    Click="Delete_Click"
                                                    ToolTip="删除策略"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 最佳/最差表现 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 最佳表现 -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" 
                        BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🏆 最佳表现" FontSize="14" FontWeight="Bold" 
                                   Foreground="#10B981" Margin="0,0,0,12"/>
                        <TextBlock x:Name="BestPerformerName" Text="暂无数据" 
                                   FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="收益率" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock x:Name="BestPerformerReturn" Text="-" 
                                           FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="夏普比率" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock x:Name="BestPerformerSharpe" Text="-" 
                                           FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 最差表现 -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" 
                        BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="⚠️ 最差表现" FontSize="14" FontWeight="Bold" 
                                   Foreground="#EF4444" Margin="0,0,0,12"/>
                        <TextBlock x:Name="WorstPerformerName" Text="暂无数据" 
                                   FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="收益率" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock x:Name="WorstPerformerReturn" Text="-" 
                                           FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="夏普比率" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock x:Name="WorstPerformerSharpe" Text="-" 
                                           FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
