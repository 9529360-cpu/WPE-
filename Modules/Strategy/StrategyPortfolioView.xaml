<UserControl x:Class="币安量化机器人.Modules.Strategy.StrategyPortfolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:币安量化机器人.Controls"
             xmlns:local="clr-namespace:币安量化机器人.Modules.Strategy"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400">
    
    <UserControl.Resources>        <local:ValueToBrushConverter x:Key="ValueToBrush"/>        <local:TimeSpanToShortStringConverter x:Key="TimeSpanToShort"/>    </UserControl.Resources>    <Grid Background="#F9FAFB">        <Grid.RowDefinitions>            <RowDefinition Height="Auto"/>            <RowDefinition Height="*"/>        </Grid.RowDefinitions>        <!-- 顶部标题栏 -->        <Border Grid.Row="0" Background="White" Padding="24,20"                 BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">            <Grid>                <Grid.ColumnDefinitions>                    <ColumnDefinition Width="Auto"/>                    <ColumnDefinition Width="*"/>                    <ColumnDefinition Width="Auto"/>                </Grid.ColumnDefinitions>                <!-- 标题 -->                <StackPanel Grid.Column="0" Orientation="Horizontal">                    <ctrl:Icon Geometry="{StaticResource Geo_Library}" Fill="{StaticResource TextPrimaryBrush}" Width="24" Height="24" Margin="0,0,12,0"/>                    <StackPanel>                        <TextBlock Text="多策略组合管理" FontSize="20" FontWeight="Bold" Foreground="#111827"/>                        <TextBlock x:Name="StatusText" Text="统一管理多个交易策略"                                    FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>                    </StackPanel>                </StackPanel>                <!-- 中部搜索 + 组合统计 -->                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="40,0" VerticalAlignment="Center">                    <!-- search box with clear button and filtered count -->                    <Grid Width="360" Margin="0,0,16,0">                        <Grid.ColumnDefinitions>                            <ColumnDefinition Width="*" />                            <ColumnDefinition Width="36" />                            <ColumnDefinition Width="Auto" />                        </Grid.ColumnDefinitions>                        <TextBox Grid.Column="0" Width="280" ToolTip="搜索策略：名称、类型、ID" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>                        <Button Grid.Column="1" Width="32" Height="28" Margin="6,0,0,0" Command="{Binding ClearSearchCommand}" ToolTip="清除搜索">                            <TextBlock Text="✖" HorizontalAlignment="Center" VerticalAlignment="Center"/>                        </Button>                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#6B7280" Text="{Binding FilteredCountText}" />                    </Grid>                     <!-- 组合统计 -->                     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">                        <!-- 总收益率 -->                        <Border Background="#F0FDF4" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">                            <StackPanel>                                <TextBlock Text="组合收益" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>                                <TextBlock Text="{Binding TotalReturnText}"                                            FontSize="24" FontWeight="Bold" Foreground="{Binding PortfolioTotalReturn, Converter={StaticResource ValueToBrush}}" Margin="0,4,0,0"/>                            </StackPanel>                        </Border>                        <!-- 夏普比率 -->                        <Border Background="#EFF6FF" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">                            <StackPanel>                                <TextBlock Text="夏普比率" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold"/>                                <TextBlock Text="{Binding SharpeText}"                                            FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>                            </StackPanel>                        </Border>                        <!-- 运行中策略 -->                        <Border Background="#FEF3C7" CornerRadius="8" Padding="16,12">                            <StackPanel>                                <TextBlock Text="运行中" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold"/>                                <TextBlock Text="{Binding RunningCountText}"                                            FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>                            </StackPanel>                        </Border>                    </StackPanel>                </StackPanel>                <!-- 操作按钮 -->                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">                    <!-- 账户模式选择 -->                    <ComboBox x:Name="AccountModeComboBox" Width="120" Margin="0,0,8,0" SelectionChanged="AccountModeComboBox_SelectionChanged">                        <ComboBoxItem>Simulated</ComboBoxItem>                        <ComboBoxItem>Live</ComboBoxItem>                    </ComboBox>                    <!-- 仅显示合约 开关 -->                    <CheckBox x:Name="FuturesOnlyCheck" Content="仅显示合约" Margin="0,0,8,0" IsChecked="{Binding FuturesOnly, Mode=TwoWay}" ToolTip="勾选时仅显示 Market=Futures 的策略"/>                    <Button x:Name="AddButton"                             Width="110" Height="36" Margin="0,0,8,0"                            Background="#10B981" Foreground="White"                            BorderThickness="0"                            FontSize="13" FontWeight="Bold"                            Command="{Binding AddCommand}">                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">                            <ctrl:Icon Geometry="{StaticResource Geo_Optimize}" Fill="White" Width="16" Height="16" Margin="0,0,8,0"/>                            <TextBlock Text="添加策略" Foreground="White" VerticalAlignment="Center"/>                        </StackPanel>                    </Button>                    <Button x:Name="BalanceButton"                            Width="110" Height="36" Margin="0,0,8,0"                            Background="#F3F4F6" Foreground="#374151"                            BorderBrush="#D1D5DB" BorderThickness="1"                            FontSize="13" FontWeight="SemiBold"                            Command="{Binding BalanceCommand}">                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">                            <ctrl:Icon Geometry="{StaticResource Geo_Performance}" Fill="#374151" Width="16" Height="16" Margin="0,0,8,0"/>                            <TextBlock Text="平衡权重" Foreground="#374151" VerticalAlignment="Center"/>                        </StackPanel>                    </Button>                    <Button x:Name="RefreshButton"                             Width="90" Height="36"                            Background="#3B82F6" Foreground="White"                            BorderThickness="0"                            FontSize="13" FontWeight="SemiBold"                            Command="{Binding RefreshCommand}">                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">                            <ctrl:Icon Geometry="{StaticResource Geo_Market}" Fill="White" Width="16" Height="16" Margin="0,0,8,0"/>                            <TextBlock Text="刷新" Foreground="White" VerticalAlignment="Center"/>                        </StackPanel>                    </Button>                 </StackPanel>            </Grid>        </Border>        <!-- 主内容区 -->        <Grid Grid.Row="1" Margin="24">            <Grid.RowDefinitions>                <RowDefinition Height="*"/>                <RowDefinition Height="8"/>                <RowDefinition Height="200"/>            </Grid.RowDefinitions>            <!-- 策略列表 -->            <Border Grid.Row="0" Background="White" CornerRadius="12"                     BorderBrush="#E5E7EB" BorderThickness="1">                <Grid>                    <Grid.RowDefinitions>                        <RowDefinition Height="Auto"/>                        <RowDefinition Height="*"/>                    </Grid.RowDefinitions>                    <!-- 列表标题 -->                    <Border Grid.Row="0" Background="#F9FAFB" Padding="20,16"                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">                        <Grid>                            <StackPanel Orientation="Horizontal">                                <ctrl:Icon Geometry="{StaticResource Geo_Library}" Fill="{StaticResource TextPrimaryBrush}" Width="18" Height="18" Margin="0,0,8,0"/>                                <TextBlock Text="策略列表" FontSize="16" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>                            </StackPanel>                             <TextBlock x:Name="StrategyCountText" Text="{Binding TotalStrategiesText}"                                         FontSize="13" Foreground="#6B7280"                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>                        </Grid>                    </Border>                    <!-- 策略表格 -->                    <DataGrid x:Name="StrategiesGrid" Grid.Row="1"                              AutoGenerateColumns="False"                              IsReadOnly="False"                              SelectionMode="Single"                              GridLinesVisibility="Horizontal"                              HeadersVisibility="Column"                              RowHeight="60"                              Background="Transparent"                              BorderThickness="0"                              ItemsSource="{Binding StrategiesView}"                              VirtualizingPanel.IsVirtualizing="True"                              VirtualizingPanel.VirtualizationMode="Standard"                              EnableRowVirtualization="True"                              EnableColumnVirtualization="True">                        <DataGrid.Columns>                            <!-- 状态 -->                            <DataGridTemplateColumn Header="状态" Width="80">                                <DataGridTemplateColumn.CellTemplate>                                    <DataTemplate>                                        <Border Background="{Binding StatusColor}"                                                 CornerRadius="4" Padding="8,4">                                            <TextBlock Text="{Binding StatusText}"                                                        FontSize="11" FontWeight="Bold"                                                       Foreground="White"                                                       HorizontalAlignment="Center"/>                                        </Border>                                    </DataTemplate>                                </DataGridTemplateColumn.CellTemplate>                            </DataGridTemplateColumn>                            <!-- 策略名称 -->                            <DataGridTextColumn Header="策略名称" Width="180" Binding="{Binding Name}">                                <DataGridTextColumn.ElementStyle>                                    <Style TargetType="TextBlock">                                        <Setter Property="FontSize" Value="14"/>                                        <Setter Property="FontWeight" Value="Bold"/>                                        <Setter Property="Foreground" Value="#111827"/>                                        <Setter Property="VerticalAlignment" Value="Center"/>                                    </Style>                                </DataGridTextColumn.ElementStyle>                            </DataGridTextColumn>                            <!-- 类型 -->                            <DataGridTextColumn Header="类型" Width="120" Binding="{Binding Type}"/>                            <!-- 市场类型 -->                            <DataGridTextColumn Header="市场" Width="100" Binding="{Binding Market}"/>                            <!-- 阶段 -->                            <DataGridTextColumn Header="阶段" Width="100" Binding="{Binding Stage}"/>                            <!-- 审计来源 -->                            <DataGridTextColumn Header="来源" Width="120" Binding="{Binding AuditSource}"/>                            <!-- 审计时间 -->                            <DataGridTextColumn Header="生成时间(UTC)" Width="160" Binding="{Binding AuditTimestampUtc, StringFormat=yyyy-MM-dd HH:mm}"/>                            <!-- 权重 -->                            <DataGridTemplateColumn Header="资金权重" Width="120">                                <DataGridTemplateColumn.CellTemplate>                                    <DataTemplate>                                        <StackPanel>                                            <TextBlock Text="{Binding WeightText}"                                                        FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>                                            <ProgressBar Value="{Binding WeightPercent, Mode=OneWay}"                                                          Height="4" Margin="0,4,0,0"                                                         Foreground="#3B82F6"/>                                        </StackPanel>                                    </DataTemplate>                                </DataGridTemplateColumn.CellTemplate>                            </DataGridTemplateColumn>                            <!-- 收益率 -->                            <DataGridTextColumn Header="总收益率" Width="100" Binding="{Binding ReturnText}">                                <DataGridTextColumn.ElementStyle>                                    <Style TargetType="TextBlock">                                        <Setter Property="Foreground" Value="{Binding TotalReturn, Converter={StaticResource ValueToBrush}}"/>                                    </Style>                                </DataGridTextColumn.ElementStyle>                            </DataGridTextColumn>                            <!-- 夏普比率 -->                            <DataGridTextColumn Header="夏普比率" Width="100" Binding="{Binding SharpeText}"/>                            <!-- 交易次数 -->                            <DataGridTextColumn Header="交易次数" Width="100" Binding="{Binding TradesText}"/>                            <!-- 胜率 -->                            <DataGridTextColumn Header="胜率" Width="80" Binding="{Binding WinRateText}"/>                            <!-- 运行时间 -->                            <DataGridTextColumn Header="运行时间" Width="100" Binding="{Binding RunningTime, Converter={StaticResource TimeSpanToShort}}"/>                            <!-- 操作 -->                            <DataGridTemplateColumn Header="操作" Width="220">                                <DataGridTemplateColumn.CellTemplate>                                    <DataTemplate>                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">                                            <Button Tag="{Binding Id}"                                                     Width="40" Height="32" Margin="0,0,4,0"                                                     Background="#10B981" Foreground="White"                                                     BorderThickness="0" FontSize="14"                                                     Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"                                                    CommandParameter="{Binding Id}"                                                    ToolTip="启动策略">                                                <ctrl:Icon Geometry="{StaticResource Geo_Trading}" Fill="White" Width="16" Height="16"/>                                            </Button>                                            <Button Tag="{Binding Id}"                                                    Width="40" Height="32" Margin="0,0,4,0"                                                    Background="#EF4444" Foreground="White"                                                    BorderThickness="0" FontSize="14"                                                    Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"                                                    CommandParameter="{Binding Id}"                                                    ToolTip="停止策略">                                                <ctrl:Icon Geometry="{StaticResource Geo_Diagnostics}" Fill="White" Width="16" Height="16"/>                                            </Button>                                            <Button Tag="{Binding Id}"                                                    Width="40" Height="32" Margin="0,0,4,0"                                                    Background="#3B82F6" Foreground="White"                                                    BorderThickness="0" FontSize="14"                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"                                                    CommandParameter="{Binding Id}"                                                    ToolTip="编辑策略">                                                <ctrl:Icon Geometry="{StaticResource Geo_Settings}" Fill="White" Width="16" Height="16"/>                                            </Button>                                            <Button Tag="{Binding Id}"                                                    Width="40" Height="32"                                                    Background="#F3F4F6" Foreground="#EF4444"                                                    BorderBrush="#E5E7EB" BorderThickness="1" FontSize="14"                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"                                                    CommandParameter="{Binding Id}"                                                    ToolTip="删除策略">                                                <ctrl:Icon Geometry="{StaticResource Geo_Alert}" Fill="#EF4444" Width="16" Height="16"/>                                            </Button>                                         </StackPanel>                                    </DataTemplate>                                </DataGridTemplateColumn.CellTemplate>                            </DataGridTemplateColumn>                        </DataGrid.Columns>                    </DataGrid>                </Grid>            </Border>            <!-- 最佳/最差表现 -->            <Grid Grid.Row="2">                <Grid.ColumnDefinitions>                    <ColumnDefinition Width="*"/>                    <ColumnDefinition Width="8"/>                    <ColumnDefinition Width="*"/>                </Grid.ColumnDefinitions>                <!-- 最佳表现 -->                <Border Grid.Column="0" Background="White" CornerRadius="12"                         BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">                    <StackPanel>                        <TextBlock Text="🏆 最佳表现" FontSize="14" FontWeight="Bold"                                    Foreground="#10B981" Margin="0,0,0,12"/>                        <TextBlock x:Name="BestPerformerName" Text="暂无数据"                                    FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>                        <Grid>                            <Grid.ColumnDefinitions>                                <ColumnDefinition Width="*"/>                                <ColumnDefinition Width="*"/>                            </Grid.ColumnDefinitions>                            <StackPanel Grid.Column="0">                                <TextBlock Text="收益率" FontSize="11" Foreground="#6B7280"/>                                <TextBlock x:Name="BestPerformerReturn" Text="-"                                            FontSize="20" FontWeight="Bold" Foreground="#10B981"/>                            </StackPanel>                            <StackPanel Grid.Column="1">                                <TextBlock Text="夏普比率" FontSize="11" Foreground="#6B7280"/>                                <TextBlock x:Name="BestPerformerSharpe" Text="-"                                            FontSize="20" FontWeight="Bold" Foreground="#111827"/>                            </StackPanel>                        </Grid>                    </StackPanel>                </Border>                <!-- 最差表现 -->                <Border Grid.Column="2" Background="White" CornerRadius="12"                         BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">                    <StackPanel>                        <TextBlock Text="⚠️ 最差表现" FontSize="14" FontWeight="Bold"                                    Foreground="#EF4444" Margin="0,0,0,12"/>                        <TextBlock x:Name="WorstPerformerName" Text="暂无数据"                                    FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>                        <Grid>                            <Grid.ColumnDefinitions>                                <ColumnDefinition Width="*"/>                                <ColumnDefinition Width="*"/>                            </Grid.ColumnDefinitions>                            <StackPanel Grid.Column="0">                                <TextBlock Text="收益率" FontSize="11" Foreground="#6B7280"/>                                <TextBlock x:Name="WorstPerformerReturn" Text="-"                                            FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>                            </StackPanel>                            <StackPanel Grid.Column="1">                                <TextBlock Text="夏普比率" FontSize="11" Foreground="#6B7280"/>                                <TextBlock x:Name="WorstPerformerSharpe" Text="-"                                            FontSize="20" FontWeight="Bold" Foreground="#111827"/>                            </StackPanel>                        </Grid>                    </StackPanel>                </Border>            </Grid>        </Grid>    </Grid></UserControl>
