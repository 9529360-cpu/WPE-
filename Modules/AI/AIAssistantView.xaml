<UserControl x:Class="币安量化机器人.Modules.AI.AIAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400">
    
    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="24,20" 
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🤖" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="AI 智能交易助手" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock x:Name="StatusText" Text="我是您的AI交易助手，告诉我您的需求" 
                                   FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- AI状态 -->
                <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="20" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#3B82F6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="AIStatusText" Text="在线" 
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B82F6"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 对话区域 -->
        <Border Grid.Row="1" Background="White" Margin="24" CornerRadius="12" 
                BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 消息列表 -->
                <ScrollViewer Grid.Row="0" x:Name="MessageScroll" 
                             VerticalScrollBarVisibility="Auto"
                             Padding="20">
                    <ItemsControl x:Name="MessagesControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,16">
                                    <!-- 用户消息 -->
                                    <Border x:Name="MessageBorder" 
                                            Background="#EFF6FF"
                                            CornerRadius="12" 
                                            Padding="16"
                                            HorizontalAlignment="Right"
                                            MaxWidth="600">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Role}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold"
                                                       Foreground="#3B82F6"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Content}" 
                                                       FontSize="14" 
                                                       Foreground="#1E3A8A"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Time}" 
                                                       FontSize="10" 
                                                       Foreground="#93C5FD"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="AI助手">
                                        <Setter TargetName="MessageBorder" Property="Background" Value="#F0FDF4"/>
                                        <Setter TargetName="MessageBorder" Property="HorizontalAlignment" Value="Left"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 快捷操作 -->
                <Border Grid.Row="1" Background="#F9FAFB" Padding="20,16"
                        BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                    <WrapPanel>
                        <Button Content="📊 分析当前市场" Tag="analyze_market" 
                                Height="32" Padding="12,0" Margin="0,0,8,8"
                                Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                Click="QuickAction_Click"/>
                        <Button Content="💹 推荐交易策略" Tag="recommend_strategy" 
                                Height="32" Padding="12,0" Margin="0,0,8,8"
                                Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                Click="QuickAction_Click"/>
                        <Button Content="🎯 优化现有策略" Tag="optimize_strategy" 
                                Height="32" Padding="12,0" Margin="0,0,8,8"
                                Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                Click="QuickAction_Click"/>
                        <Button Content="⚠️ 评估风险" Tag="assess_risk" 
                                Height="32" Padding="12,0" Margin="0,0,8,8"
                                Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                Click="QuickAction_Click"/>
                        <Button Content="📈 查看绩效" Tag="show_performance" 
                                Height="32" Padding="12,0" Margin="0,0,8,8"
                                Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                Click="QuickAction_Click"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 输入区域 -->
        <Border Grid.Row="2" Background="White" Margin="24,0,24,24" 
                CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox" 
                         Grid.Column="0"
                         FontSize="14"
                         Padding="12"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         TextWrapping="Wrap"
                         MaxHeight="120"
                         KeyDown="Input_KeyDown"
                         Text="输入您的问题或指令..."/>

                <Button x:Name="SendButton" 
                        Grid.Column="1"
                        Content="发送"
                        Width="100" Height="44"
                        Margin="8,0,0,0"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Click="Send_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
