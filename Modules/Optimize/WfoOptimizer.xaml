<UserControl x:Class="币安量化机器人.Modules.Optimize.WfoOptimizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1F2937" Padding="16" CornerRadius="8" Margin="0,0,0,12">
            <TextBlock Text="🔬 策略参数优化器 (WFO)" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="White"/>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧: 参数配置 -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#E5E7EB" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="优化参数配置" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Margin="0,0,0,16"/>
                    
                    <TextBox x:Name="InSampleDaysInput" Height="36" Text="365" Margin="0,0,0,8"/>
                    <TextBox x:Name="OutSampleDaysInput" Height="36" Text="90" Margin="0,0,0,8"/>
                    <TextBox x:Name="FastMaMinInput" Height="36" Text="5" Margin="0,0,0,8"/>
                    <TextBox x:Name="FastMaMaxInput" Height="36" Text="35" Margin="0,0,0,8"/>
                    <TextBox x:Name="FastMaStepInput" Height="36" Text="5" Margin="0,0,0,8"/>
                    <TextBox x:Name="SlowMaMinInput" Height="36" Text="80" Margin="0,0,0,8"/>
                    <TextBox x:Name="SlowMaMaxInput" Height="36" Text="180" Margin="0,0,0,8"/>
                    <TextBox x:Name="SlowMaStepInput" Height="36" Text="20" Margin="0,0,0,16"/>
                    
                    <Button Content="▶️ 启动优化"
                            Height="40"
                            Background="#10B981"
                            Foreground="White"
                            BorderThickness="0"
                            Click="StartOptimization_Click"/>
                    
                    <TextBlock x:Name="StatusText"
                               Text="📊 状态: 就绪"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 右侧: 结果展示 -->
            <Border Grid.Column="2"
                    Background="White" 
                    BorderBrush="#E5E7EB" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="优化结果" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1" 
                              x:Name="ResultsGrid" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="排名" Binding="{Binding Rank}" Width="60"/>
                            <DataGridTextColumn Header="快速MA" Binding="{Binding FastMa}" Width="80"/>
                            <DataGridTextColumn Header="慢速MA" Binding="{Binding SlowMa}" Width="80"/>
                            <DataGridTextColumn Header="夏普" Binding="{Binding SharpeRatio, StringFormat=F2}" Width="80"/>
                            <DataGridTextColumn Header="收益" Binding="{Binding AnnualReturn, StringFormat=P2}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="最佳参数:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="快速MA:" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BestFastMaText" Text="20" FontWeight="Bold" Margin="0,0,16,0"/>
                            <TextBlock Text="慢速MA:" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BestSlowMaText" Text="120" FontWeight="Bold" Margin="0,0,16,0"/>
                            <TextBlock Text="夏普:" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BestSharpeText" Text="2.15" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="OosPerformanceText" Text="OOS表现: 稳定" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
