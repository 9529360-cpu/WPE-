<UserControl x:Class="币安量化机器人.Modules.Account.AccountFundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:币安量化机器人.Controls"
             Background="#F9FAFB">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1F2937" Padding="16" CornerRadius="8" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Grid Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource Geo_Account}" Fill="White" Stretch="Uniform"/>
                    </Grid>
                    <TextBlock Text="账户与资金管理" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="White" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Content="🔄 刷新"
                        Height="36"
                        Padding="16,0"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        Click="Refresh_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>

        <!-- 账户卡片 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 模拟账户 -->
            <Border Grid.Column="0" 
                    x:Name="SimulatedAccountCard"
                    Background="White" 
                    BorderBrush="#10B981" 
                    BorderThickness="2" 
                    CornerRadius="12" 
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource Geo_Account}" Fill="#10B981" Stretch="Uniform"/>
                            </Grid>
                            <TextBlock Text="模拟账户" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Background="#10B981" 
                                CornerRadius="4" 
                                Padding="8,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <TextBlock Text="当前使用" 
                                       FontSize="12" 
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </Border>
                    </DockPanel>

                    <!-- 净值 -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="账户净值" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock x:Name="SimNetValueText" 
                                   Text="10,000.00 USDT" 
                                   FontSize="32" 
                                   FontWeight="Bold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 详细信息 -->
                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="可用余额" FontSize="12" Foreground="#6B7280"/>
                            <TextBlock x:Name="SimAvailableText" 
                                       Text="10,000.00" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="持仓市值" FontSize="12" Foreground="#6B7280"/>
                            <TextBlock x:Name="SimPositionValueText" 
                                       Text="0.00" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 统计 -->
                    <Border Grid.Row="3" 
                            Background="#F3F4F6" 
                            CornerRadius="8" 
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="总盈亏" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock x:Name="SimTotalPnLText" 
                                           Text="+0.00" 
                                           FontSize="14" 
                                           FontWeight="Bold"
                                           Foreground="#22C55E"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="交易次数" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock x:Name="SimTradesText" 
                                           Text="0 笔" 
                                           FontSize="14" 
                                           FontWeight="Bold"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="胜率" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock x:Name="SimWinRateText" 
                                           Text="0%" 
                                           FontSize="14" 
                                           FontWeight="Bold"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右: 真实账户 -->
            <Border Grid.Column="2" 
                    x:Name="LiveAccountCard"
                    Background="White" 
                    BorderBrush="#E5E7EB" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource Geo_Account}" Fill="#9CA3AF" Stretch="Uniform"/>
                            </Grid>
                            <TextBlock Text="真实账户" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border x:Name="LiveAccountStatusBadge"
                                Background="#9CA3AF" 
                                CornerRadius="4" 
                                Padding="8,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <TextBlock Text="未激活" 
                                       FontSize="12" 
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </Border>
                    </DockPanel>

                    <!-- 净值 -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="账户净值" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock x:Name="LiveNetValueText" 
                                   Text="0.00 USDT" 
                                   FontSize="32" 
                                   FontWeight="Bold"
                                   Foreground="#9CA3AF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 详细信息 -->
                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="可用余额" FontSize="12" Foreground="#6B7280"/>
                            <TextBlock x:Name="LiveAvailableText" 
                                       Text="0.00" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       Foreground="#9CA3AF"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="持仓市值" FontSize="12" Foreground="#6B7280"/>
                            <TextBlock x:Name="LivePositionValueText" 
                                       Text="0.00" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       Foreground="#9CA3AF"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 升级检查 -->
                    <Button x:Name="CheckUpgradeButton"
                            Grid.Row="3"
                            Content="🔓 检查升级条件"
                            Height="40"
                            Background="#3B82F6"
                            Foreground="White"
                            BorderThickness="0"
                            Click="CheckUpgrade_Click"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 升级规则与账户切换 -->
        <TabControl Grid.Row="2" 
                    Background="White"
                    BorderThickness="0">
            
            <!-- Tab 1: 升级规则 -->
            <TabItem Header="📋 升级规则检查" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="真实账户升级条件" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,16"/>
                            
                            <TextBlock Text="需满足以下7项条件才能升级到真实账户:" 
                                       FontSize="14" 
                                       Foreground="#6B7280"
                                       Margin="0,0,0,16"/>

                            <!-- 规则列表 -->
                            <ItemsControl x:Name="UpgradeRulesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" 
                                                BorderBrush="#E5E7EB" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="16" 
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 图标 -->
                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding Icon}" 
                                                           FontSize="24" 
                                                           Margin="0,0,12,0"
                                                           VerticalAlignment="Center"/>

                                                <!-- 规则信息 -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding RuleName}" 
                                                               FontSize="14" 
                                                               FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}" 
                                                               FontSize="12" 
                                                               Foreground="#6B7280"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding CurrentValue}" 
                                                               FontSize="13" 
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- 状态 -->
                                                <Border Grid.Column="2" 
                                                        Background="{Binding StatusColor}" 
                                                        CornerRadius="4" 
                                                        Padding="8,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" 
                                                               FontSize="12" 
                                                               Foreground="White"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 升级按钮 -->
                            <Button x:Name="UpgradeButton"
                                    Height="48"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Background="#10B981"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Margin="0,16,0,0"
                                    Click="Upgrade_Click"
                                    IsEnabled="False"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ctrl:Icon Geometry="{StaticResource Geo_Account}" Fill="White" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="升级到真实账户" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 2: 账户切换 -->
            <TabItem Header="🔄 账户切换" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <StackPanel>
                        <TextBlock Text="选择使用的账户" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,16"/>

                        <!-- 模拟账户选项 -->
                        <RadioButton x:Name="UseSimulatedRadio"
                                     GroupName="AccountType"
                                     IsChecked="True"
                                     Margin="0,0,0,16"
                                     Checked="AccountType_Changed">
                            <RadioButton.Content>
                                <StackPanel>
                                    <TextBlock Text="💰 使用模拟账户" 
                                               FontSize="16" 
                                               FontWeight="Bold"/>
                                    <TextBlock Text="安全的模拟交易环境,不会动用真实资金" 
                                               FontSize="12" 
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- 真实账户选项 -->
                        <RadioButton x:Name="UseLiveRadio"
                                     GroupName="AccountType"
                                     IsEnabled="False"
                                     Checked="AccountType_Changed">
                            <RadioButton.Content>
                                <StackPanel>
                                    <TextBlock Text="💵 使用真实账户" 
                                               FontSize="16" 
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="LiveAccountHint"
                                               Text="需先满足升级条件" 
                                               FontSize="12" 
                                               Foreground="#EF4444"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
