<UserControl x:Class="币安量化机器人.Modules.Dashboard.UnifiedDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    
    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="24,20" 
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🎯" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="AI 智能交易仪表盘" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock x:Name="StatusText" Text="实时监控 · 智能决策 · 自动执行" 
                                   FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 系统状态 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                           HorizontalAlignment="Center" Margin="40,0">
                    <Border Background="#10B981" CornerRadius="20" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="SystemStatusText" Text="系统运行中" 
                                       FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock x:Name="CurrentTimeText" Text="2024-01-15 14:30:25" 
                               FontSize="13" Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 快捷操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="StartAIButton" Content="▶️ 启动AI" 
                            Width="100" Height="38" Margin="0,0,8,0"
                            Background="#10B981" Foreground="White"
                            BorderThickness="0"
                            FontSize="14" FontWeight="Bold"/>
                    
                    <Button x:Name="StopAIButton" Content="⏹️ 停止" 
                            Width="100" Height="38"
                            Background="#EF4444" Foreground="White"
                            BorderThickness="0"
                            FontSize="14" FontWeight="Bold"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行: 核心指标卡片 -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 账户净值 -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" 
                            BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="💰 账户净值" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock x:Name="NetValueText" Text="10,000 USDT" 
                                       FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,6,0,0"/>
                            <TextBlock x:Name="NetValueChangeText" Text="+250 (2.5%)" 
                                       FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 今日收益 -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" 
                            BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="📈 今日收益" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TodayPnLText" Text="+125 USDT" 
                                       FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TodayReturnText" Text="+1.25%" 
                                       FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 持仓数量 -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" 
                            BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="📊 持仓数量" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PositionCountText" Text="3" 
                                       FontSize="20" FontWeight="Bold" Foreground="#3B82F6" Margin="0,6,0,0"/>
                            <TextBlock Text="个持仓" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 今日信号 -->
                    <Border Grid.Column="3" Background="White" CornerRadius="12" 
                            BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="📡 今日信号" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TodaySignalsText" Text="15" 
                                       FontSize="20" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,6,0,0"/>
                            <TextBlock x:Name="SignalExecutionText" Text="12 已执行" 
                                       FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 胜率 -->
                    <Border Grid.Column="4" Background="White" CornerRadius="12" 
                            BorderBrush="#E5E7EB" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="🎯 胜率" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WinRateText" Text="68%" 
                                       FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,0"/>
                            <TextBlock x:Name="WinLossText" Text="17/25 笔" 
                                       FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 第二行: 实时信号流 + 持仓监控 -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 实时信号流 -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" 
                            BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="300"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F9FAFB" Padding="16"
                                    BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="实时交易信号" FontSize="14" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="最近10条" FontSize="12" Foreground="#6B7280" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1" x:Name="SignalsListBox" 
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" CornerRadius="6" Padding="12" Margin="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#9CA3AF"/>
                                                    <TextBlock Text="{Binding Symbol}" FontSize="13" FontWeight="Bold" Foreground="#111827" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Action}" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Confidence}" FontSize="11" Foreground="#8B5CF6" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#10B981" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 持仓监控 -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" 
                            BorderBrush="#E5E7EB" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F9FAFB" Padding="16"
                                    BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="持仓监控" FontSize="14" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="1" x:Name="PositionsListBox" 
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" CornerRadius="6" Padding="12" Margin="12,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="{Binding Symbol}" 
                                                           FontSize="13" FontWeight="Bold" Foreground="#111827"/>
                                                
                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding EntryPrice, StringFormat='入场: {0:F2}'}" 
                                                               FontSize="11" Foreground="#6B7280"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CurrentPrice, StringFormat='当前: {0:F2}'}" 
                                                               FontSize="11" Foreground="#6B7280"/>
                                                </Grid>

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding PnL}" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding PnLPercent}" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 第三行: 策略组合 + 风险预警 -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 策略组合 -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" 
                            BorderBrush="#E5E7EB" BorderThickness="1" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="🎛️ 运行中的策略" FontSize="14" FontWeight="Bold" 
                                       Foreground="#111827" Margin="0,0,0,16"/>
                            
                            <ItemsControl x:Name="StrategiesControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#111827"/>
                                                <ProgressBar Value="{Binding Progress}" Height="4" Margin="0,6,0,0" Foreground="#3B82F6"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Return}" 
                                                       FontSize="13" FontWeight="Bold" Margin="12,0"/>
                                            
                                            <Border Grid.Column="2" Background="#10B981" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="运行中" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 风险预警 -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" 
                            BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <TextBlock Text="⚠️ 风险预警" FontSize="14" FontWeight="Bold" 
                                       Foreground="#111827" Margin="0,0,0,16"/>
                            
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="仓位占比提醒" FontSize="12" FontWeight="Bold" Foreground="#D97706"/>
                                        <TextBlock Text="BTC仓位已达60%，建议降低风险" FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#D1FAE5" CornerRadius="6" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="✅" FontSize="16" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="风险控制正常" FontSize="12" FontWeight="Bold" Foreground="#059669"/>
                                        <TextBlock Text="所有风险指标在安全范围内" FontSize="11" Foreground="#047857" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 第四行: 快速访问 -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Height="80" Margin="0,0,10,0"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📡" FontSize="24"/>
                                <TextBlock Text="信号监控" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="1" Height="80" Margin="0,0,10,0"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📈" FontSize="24"/>
                                <TextBlock Text="绩效分析" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="2" Height="80" Margin="0,0,10,0"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🧬" FontSize="24"/>
                                <TextBlock Text="参数优化" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="3" Height="80"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🎛️" FontSize="24"/>
                                <TextBlock Text="策略组合" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
