<UserControl x:Class="币安量化机器人.Modules.Dashboard.UnifiedDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    
    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="24,20" 
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🅰️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Alpha Arena 量化仪表盘" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock x:Name="StatusText" Text="实时监控 · 智能决策 · 自动执行" 
                                   FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 系统状态 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                           HorizontalAlignment="Center" Margin="40,0">
                    <Border Background="#10B981" CornerRadius="20" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="SystemStatusText" Text="系统运行中" 
                                       FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock x:Name="CurrentTimeText" Text="2024-01-15 14:30:25" 
                               FontSize="13" Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 快捷操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💡 提示: 在下方 AI Tab 中启动交易" 
                               FontSize="12" Foreground="#6B7280" 
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <ComboBox x:Name="AccountTypeCombo" Width="120" Margin="0,0,8,0">
                        <ComboBoxItem Tag="Sim">Simulated</ComboBoxItem>
                        <ComboBoxItem Tag="Live">Live</ComboBoxItem>
                    </ComboBox>
                    <TextBox x:Name="SymbolsInput" Width="200" Text="BTCUSDT" Margin="0,0,8,0"/>
                    <Button x:Name="StartAIButton" Content="▶️ 启动AI" Width="100" Margin="0,0,8,0"/>
                    <Button x:Name="StopAIButton" Content="⏹ 停止AI" Width="100" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区: 左侧为 CombinedHost, 右侧为侧边栏 -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="CombinedHost" Grid.Column="0"/>

            <!-- 侧边栏 -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="运行中策略" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <ListView x:Name="RunningStrategiesList" Height="160" Margin="0,0,0,8">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SymbolsText}" FontSize="12" Foreground="#6B7280"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="最近订单" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,8,0,8"/>
                    <ListView x:Name="RecentOrdersList" Height="140" Margin="0,0,0,8">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding Symbol}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ShortInfo}" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#6B7280" VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Learning actions -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                        <Button x:Name="ExportTrainingButton" Content="导出训练数据" Height="32" Margin="0,0,0,8" Click="ExportTraining_Click"/>
                        <Button x:Name="StartTrainingButton" Content="开始训练" Height="32" Click="StartTraining_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TrainingStatusText" Text="" FontSize="12" Foreground="#6B7280" Margin="0,8,0,0"/>

                    <!-- 学习管理 -->
                    <Separator Margin="0,12,0,12"/>
                    <TextBlock Text="学习管理" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                        <Button x:Name="SaveLearningStateButton" Content="保存学习状态" Width="120" Height="28" Margin="0,0,8,0" Click="SaveLearningState_Click"/>
                        <Button x:Name="LoadLearningStateButton" Content="加载学习状态" Width="120" Height="28" Margin="0,0,8,0" Click="LoadLearningState_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <Button x:Name="ResetLearningButton" Content="重置学习状态" Width="120" Height="28" Click="ResetLearning_Click"/>
                    </StackPanel>

                    <TextBlock Text="因子性能" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <ListView x:Name="FactorStatsList" Height="180">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="因子" DisplayMemberBinding="{Binding FactorCode}" Width="120" />
                                <GridViewColumn Header="样本" DisplayMemberBinding="{Binding TotalSamples}" Width="60" />
                                <GridViewColumn Header="胜率" DisplayMemberBinding="{Binding WinRateText}" Width="60" />
                                <GridViewColumn Header="平均收益" DisplayMemberBinding="{Binding AvgProfitText}" Width="80" />
                                <GridViewColumn Header="相关" DisplayMemberBinding="{Binding CorrelationText}" Width="60" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
