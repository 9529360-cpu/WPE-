<UserControl x:Class="币安量化机器人.Modules.Dashboard.UnifiedDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    
    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏（保留，但移除启动按钮，启动功能由子模块 AI Tab 提供） -->
        <Border Grid.Row="0" Background="White" Padding="24,20" 
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🅰️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Alpha Arena 量化仪表盘" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock x:Name="StatusText" Text="实时监控 · 智能决策 · 自动执行" 
                                   FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 系统状态 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                           HorizontalAlignment="Center" Margin="40,0">
                    <Border Background="#10B981" CornerRadius="20" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="SystemStatusText" Text="系统运行中" 
                                       FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock x:Name="CurrentTimeText" Text="2024-01-15 14:30:25" 
                               FontSize="13" Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 快捷操作（移除启动/停止按钮，保留自动驾驶开关） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💡 提示: 在下方 AI Tab 中启动交易" 
                               FontSize="12" Foreground="#6B7280" 
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox x:Name="AutoPilotToggle" Content="AI全自动" 
                              Margin="0,0,12,0" VerticalAlignment="Center"
                              ToolTip="启用AI全自动模式（需先启动交易）"/>
                    <CheckBox x:Name="LiveAutoPilotToggle" Content="实盘自动驾驶" 
                              Margin="0,0,0,0" VerticalAlignment="Center"
                              ToolTip="启用实盘自动驾驶（谨慎开启）"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <!-- LegacyContent 保留原始布局以便回退，初始隐藏 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="LegacyContent" Visibility="Collapsed">
            <Grid Margin="24">
                <!-- 原始内容保留用于回退 -->
            </Grid>
        </ScrollViewer>

        <!-- 综合模块宿主：显示打包后的五个子模块（默认显示） -->
        <ContentControl x:Name="CombinedHost" Grid.Row="1"/>
    </Grid>
</UserControl>
