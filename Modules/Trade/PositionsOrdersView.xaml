<UserControl x:Class="币安量化机器人.Modules.Trade.PositionsOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1F2937" Padding="16" CornerRadius="8" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="📑 持仓与订单管理" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                
                <Button Content="🔄 刷新数据"
                        Height="36"
                        Padding="16,0"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        Click="Refresh_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>

        <!-- Tab切换 -->
        <TabControl Grid.Row="1" 
                    Background="White"
                    BorderThickness="0">
            
            <!-- Tab 1: 当前持仓 -->
            <TabItem Header="📊 当前持仓" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 持仓统计卡片 -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 总持仓 -->
                            <Border Grid.Column="0" Background="#F3F4F6" 
                                    BorderBrush="#E5E7EB" BorderThickness="1" 
                                    CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="总持仓数" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock x:Name="TotalPositionsText" 
                                               Text="0 个" 
                                               FontSize="24" 
                                               FontWeight="Bold"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 持仓市值 -->
                            <Border Grid.Column="2" Background="#F3F4F6" 
                                    BorderBrush="#E5E7EB" BorderThickness="1" 
                                    CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="持仓市值" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock x:Name="TotalPositionValueText" 
                                               Text="0.00 USDT" 
                                               FontSize="24" 
                                               FontWeight="Bold"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 未实现盈亏 -->
                            <Border Grid.Column="4" Background="#F3F4F6" 
                                    BorderBrush="#E5E7EB" BorderThickness="1" 
                                    CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="未实现盈亏" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock x:Name="TotalUnrealizedPnLText" 
                                               Text="+0.00 (+0.00%)" 
                                               FontSize="24" 
                                               FontWeight="Bold"
                                               Foreground="#22C55E"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 持仓列表 -->
                        <DataGrid Grid.Row="1" 
                                  x:Name="PositionsGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1"
                                  BorderBrush="#E5E7EB"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F9FAFB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="交易对" Binding="{Binding Symbol}" Width="100"/>
                                <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="60"/>
                                <DataGridTextColumn Header="数量" Binding="{Binding Quantity, StringFormat=F4}" Width="100"/>
                                <DataGridTextColumn Header="开仓价" Binding="{Binding EntryPrice, StringFormat=F2}" Width="100"/>
                                <DataGridTextColumn Header="当前价" Binding="{Binding CurrentPrice, StringFormat=F2}" Width="100"/>
                                <DataGridTextColumn Header="止损" Binding="{Binding StopLoss, StringFormat=F2}" Width="80"/>
                                <DataGridTextColumn Header="止盈" Binding="{Binding TakeProfit, StringFormat=F2}" Width="80"/>
                                <DataGridTextColumn Header="未实现盈亏" Binding="{Binding UnrealizedPnL, StringFormat=F2}" Width="120"/>
                                <DataGridTextColumn Header="盈亏%" Binding="{Binding PnLPercent, StringFormat=P2}" Width="80"/>
                                <DataGridTextColumn Header="持仓时长(h)" Binding="{Binding HoldingHours, StringFormat=F1}" Width="100"/>
                                <DataGridTemplateColumn Header="操作" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="平仓" 
                                                    Height="28" 
                                                    Padding="12,0"
                                                    Background="#EF4444"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Click="ClosePosition_Click"
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 2: 订单历史 -->
            <TabItem Header="📋 订单历史" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 筛选栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="状态筛选:" 
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="OrderStatusFilter" 
                                      Width="150" 
                                      Height="32"
                                      SelectionChanged="OrderStatusFilter_Changed">
                                <ComboBoxItem Content="全部" IsSelected="True"/>
                                <ComboBoxItem Content="已成交"/>
                                <ComboBoxItem Content="部分成交"/>
                                <ComboBoxItem Content="已取消"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 订单列表 -->
                        <DataGrid Grid.Row="1" 
                                  x:Name="OrdersGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1"
                                  BorderBrush="#E5E7EB"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F9FAFB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="订单ID" Binding="{Binding OrderId}" Width="120"/>
                                <DataGridTextColumn Header="交易对" Binding="{Binding Symbol}" Width="100"/>
                                <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="60"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
                                <DataGridTextColumn Header="委托价" Binding="{Binding Price, StringFormat=F2}" Width="100"/>
                                <DataGridTextColumn Header="委托量" Binding="{Binding Quantity, StringFormat=F4}" Width="100"/>
                                <DataGridTextColumn Header="成交价" Binding="{Binding ExecutedPrice, StringFormat=F2}" Width="100"/>
                                <DataGridTextColumn Header="成交量" Binding="{Binding ExecutedQuantity, StringFormat=F4}" Width="100"/>
                                <DataGridTextColumn Header="手续费" Binding="{Binding Commission, StringFormat=F4}" Width="80"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 3: 交易统计 -->
            <TabItem Header="📈 交易统计" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 统计卡片组1 -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#F3F4F6" 
                                        BorderBrush="#E5E7EB" BorderThickness="1" 
                                        CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="总交易次数" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock x:Name="TotalTradesCountText" 
                                                   Text="0 笔" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#F3F4F6" 
                                        BorderBrush="#E5E7EB" BorderThickness="1" 
                                        CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="胜率" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock x:Name="WinRateText" 
                                                   Text="0%" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Foreground="#22C55E"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="#F3F4F6" 
                                        BorderBrush="#E5E7EB" BorderThickness="1" 
                                        CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="盈亏比" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock x:Name="ProfitFactorText" 
                                                   Text="0.00" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 统计卡片组2 -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#ECFDF5" 
                                        BorderBrush="#A7F3D0" BorderThickness="1" 
                                        CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="盈利次数" FontSize="12" Foreground="#10B981"/>
                                        <TextBlock x:Name="WinningTradesText" 
                                                   Text="0 笔" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Foreground="#10B981"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#FEF2F2" 
                                        BorderBrush="#FECACA" BorderThickness="1" 
                                        CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="亏损次数" FontSize="12" Foreground="#EF4444"/>
                                        <TextBlock x:Name="LosingTradesText" 
                                                   Text="0 笔" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Foreground="#EF4444"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 详细统计 -->
                            <Border Grid.Row="2" 
                                    Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="详细统计" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               Margin="0,0,0,12"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="平均持仓时长:" Foreground="#6B7280"/>
                                                <TextBlock x:Name="AvgHoldingTimeText" 
                                                           Text="0.0 小时" 
                                                           HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="平均盈利:" Foreground="#6B7280"/>
                                                <TextBlock x:Name="AvgWinText" 
                                                           Text="0.00 USDT" 
                                                           HorizontalAlignment="Right"
                                                           Foreground="#22C55E"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="平均亏损:" Foreground="#6B7280"/>
                                                <TextBlock x:Name="AvgLossText" 
                                                           Text="0.00 USDT" 
                                                           HorizontalAlignment="Right"
                                                           Foreground="#EF4444"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="最大单笔盈利:" Foreground="#6B7280"/>
                                                <TextBlock x:Name="MaxWinText" 
                                                           Text="0.00 USDT" 
                                                           HorizontalAlignment="Right"
                                                           Foreground="#22C55E"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="最大单笔亏损:" Foreground="#6B7280"/>
                                                <TextBlock x:Name="MaxLossText" 
                                                           Text="0.00 USDT" 
                                                           HorizontalAlignment="Right"
                                                           Foreground="#EF4444"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="总手续费:" Foreground="#6B7280"/>
                                                <TextBlock x:Name="TotalCommissionText" 
                                                           Text="0.00 USDT" 
                                                           HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
