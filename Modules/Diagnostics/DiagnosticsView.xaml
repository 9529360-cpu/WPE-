<UserControl x:Class="币安量化机器人.Modules.Diagnostics.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:币安量化机器人.Helpers">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0F172A" Padding="12" CornerRadius="6">
            <TextBlock Text="诊断信息" FontSize="16" FontWeight="Bold" Foreground="White"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,12" helpers:StackPanelHelper.Spacing="12">
            <TextBlock x:Name="EnvironmentText" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock Text="日志输出" FontWeight="Bold"/>
            <TextBox x:Name="LogBox" Height="240" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"/>
            <Button Content="刷新" Width="120" Height="32" Click="Refresh_Click"/>
        </StackPanel>

        <StatusBar Grid.Row="2" Background="#E2E8F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：等待刷新"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
