<UserControl x:Class="币安量化机器人.Modules.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1F2937" Padding="16" CornerRadius="8" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="⚙️ 策略配置中心" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="💾 保存配置"
                            Height="36"
                            Padding="16,0"
                            Margin="0,0,8,0"
                            Background="#10B981"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SaveConfig_Click"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#059669"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Content="🔄 重置默认"
                            Height="36"
                            Padding="16,0"
                            Background="#EF4444"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ResetConfig_Click"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tab切换 -->
        <TabControl Grid.Row="1" 
                    Background="White"
                    BorderThickness="0">
            
            <!-- Tab 1: AI策略配置 -->
            <TabItem Header="🤖 AI策略" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="AI交易策略参数" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,16"/>

                            <!-- 信心度阈值 -->
                            <Border Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="信心度阈值" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="AI生成的交易信号需要达到此信心度才会执行" 
                                               FontSize="12" 
                                               Foreground="#6B7280"
                                               Margin="0,0,0,8"/>
                                    
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="当前值:" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ConfidenceValueText" 
                                                   Text="70%" 
                                                   FontWeight="Bold"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="ConfidenceSlider"
                                                Minimum="50"
                                                Maximum="95"
                                                Value="70"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="ConfidenceSlider_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 最大仓位占比 -->
                            <Border Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="单笔最大仓位" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="单笔交易最多使用账户总资金的比例" 
                                               FontSize="12" 
                                               Foreground="#6B7280"
                                               Margin="0,0,0,8"/>
                                    
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="当前值:" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MaxPositionValueText" 
                                                   Text="20%" 
                                                   FontWeight="Bold"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="MaxPositionSlider"
                                                Minimum="5"
                                                Maximum="50"
                                                Value="20"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="MaxPositionSlider_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 止损比例 -->
                            <Border Background="#FEF2F2" 
                                    BorderBrush="#FECACA" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="止损比例" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="持仓亏损达到此比例时自动止损" 
                                               FontSize="12" 
                                               Foreground="#991B1B"
                                               Margin="0,0,0,8"/>
                                    
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="当前值:" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StopLossValueText" 
                                                   Text="5%" 
                                                   FontWeight="Bold"
                                                   Foreground="#DC2626"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="StopLossSlider"
                                                Minimum="2"
                                                Maximum="20"
                                                Value="5"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="StopLossSlider_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 止盈比例 -->
                            <Border Background="#ECFDF5" 
                                    BorderBrush="#A7F3D0" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="止盈比例" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="持仓盈利达到此比例时自动止盈" 
                                               FontSize="12" 
                                               Foreground="#065F46"
                                               Margin="0,0,0,8"/>
                                    
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="当前值:" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TakeProfitValueText" 
                                                   Text="10%" 
                                                   FontWeight="Bold"
                                                   Foreground="#10B981"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="TakeProfitSlider"
                                                Minimum="5"
                                                Maximum="50"
                                                Value="10"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="TakeProfitSlider_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 2: 风控配置 -->
            <TabItem Header="🛡️ 风控参数" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="风险控制参数" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,16"/>

                            <!-- 最大持仓数 -->
                            <Border Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="最大持仓数量" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    
                                    <TextBox x:Name="MaxPositionsInput"
                                             Height="36"
                                             FontSize="14"
                                             Text="5"
                                             Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 每日最大亏损 -->
                            <Border Background="#FEF2F2" 
                                    BorderBrush="#FECACA" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="每日最大亏损" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="当日累计亏损超过此比例后停止交易" 
                                               FontSize="12" 
                                               Foreground="#991B1B"
                                               Margin="0,0,0,8"/>
                                    
                                    <TextBox x:Name="DailyLossLimitInput"
                                             Height="36"
                                             FontSize="14"
                                             Text="5"
                                             Margin="0,8,0,0"/>
                                    <TextBlock Text="单位: %" 
                                               FontSize="11" 
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 最大回撤限制 -->
                            <Border Background="#FEF2F2" 
                                    BorderBrush="#FECACA" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="最大回撤限制" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    
                                    <TextBox x:Name="MaxDrawdownInput"
                                             Height="36"
                                             FontSize="14"
                                             Text="15"
                                             Margin="0,8,0,0"/>
                                    <TextBlock Text="单位: %" 
                                               FontSize="11" 
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 持仓时间限制 -->
                            <Border Background="#FFFBEB" 
                                    BorderBrush="#FDE68A" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="最大持仓时间" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="超过此时间后自动平仓" 
                                               FontSize="12" 
                                               Foreground="#92400E"
                                               Margin="0,0,0,8"/>
                                    
                                    <TextBox x:Name="MaxHoldingHoursInput"
                                             Height="36"
                                             FontSize="14"
                                             Text="24"
                                             Margin="0,8,0,0"/>
                                    <TextBlock Text="单位: 小时" 
                                               FontSize="11" 
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 3: API配置 -->
            <TabItem Header="🔑 API设置" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Binance API 配置" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,16"/>

                            <!-- API Key -->
                            <Border Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="API Key" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    
                                    <TextBox x:Name="ApiKeyInput"
                                             Height="36"
                                             FontSize="14"
                                             Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- API Secret -->
                            <Border Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="API Secret" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    
                                    <PasswordBox x:Name="ApiSecretInput"
                                                 Height="36"
                                                 FontSize="14"
                                                 Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 测试连接 -->
                            <Button Content="🔗 测试API连接"
                                    Height="40"
                                    FontSize="14"
                                    Background="#3B82F6"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="TestApiConnection_Click"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- DeepSeek API -->
                            <TextBlock Text="DeepSeek AI 配置" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Margin="0,24,0,16"/>

                            <Border Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="DeepSeek API Key" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    
                                    <TextBox x:Name="DeepSeekApiKeyInput"
                                             Height="36"
                                             FontSize="14"
                                             Margin="0,8,0,0"/>
                                    
                                    <TextBlock Text="用于AI交易信号生成" 
                                               FontSize="11" 
                                               Foreground="#6B7280"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
