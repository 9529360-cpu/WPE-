<UserControl x:Class="币安量化机器人.Modules.Settings.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1F2937" Padding="16" CornerRadius="8" Margin="0,0,0,12">
            <TextBlock Text="⚙️ 系统设置" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="White"/>
        </Border>

        <!-- 设置项 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 系统行为 -->
                <Border Background="White" 
                        BorderBrush="#E5E7EB" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="系统行为" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                        
                        <CheckBox x:Name="AutoReconnectBox" 
                                  Content="断线自动重连WebSocket" 
                                  IsChecked="True"
                                  FontSize="14"
                                  Margin="0,0,0,12"/>
                        
                        <CheckBox x:Name="EnableNotificationsBox" 
                                  Content="启用系统通知" 
                                  IsChecked="True"
                                  FontSize="14"
                                  Margin="0,0,0,12"/>
                        
                        <CheckBox x:Name="AutoSaveLogsBox" 
                                  Content="自动保存交易日志" 
                                  IsChecked="True"
                                  FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- 性能设置 -->
                <Border Background="White" 
                        BorderBrush="#E5E7EB" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="性能设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                        
                        <TextBlock Text="数据刷新频率(秒)" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBox x:Name="RefreshIntervalInput" 
                                 Height="36" 
                                 Text="1"
                                 FontSize="14"
                                 Margin="0,0,0,12"/>
                        
                        <TextBlock Text="最大缓存条数" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBox x:Name="MaxCacheItemsInput" 
                                 Height="36" 
                                 Text="1000"
                                 FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- 日志设置 -->
                <Border Background="White" 
                        BorderBrush="#E5E7EB" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="日志设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                        
                        <TextBlock Text="日志级别" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <ComboBox x:Name="LogLevelCombo" 
                                  Height="36"
                                  FontSize="14"
                                  Margin="0,0,0,12">
                            <ComboBoxItem Content="Trace (最详细)"/>
                            <ComboBoxItem Content="Debug (调试)"/>
                            <ComboBoxItem Content="Information (信息)" IsSelected="True"/>
                            <ComboBoxItem Content="Warning (警告)"/>
                            <ComboBoxItem Content="Error (错误)"/>
                        </ComboBox>
                        
                        <Button Content="📂 打开日志目录"
                                Height="36"
                                HorizontalAlignment="Left"
                                Click="OpenLogFolder_Click"/>
                    </StackPanel>
                </Border>

                <!-- 保存按钮 -->
                <Button Content="💾 保存设置"
                        Height="48"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SaveSettings_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
