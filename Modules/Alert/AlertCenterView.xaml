<UserControl x:Class="币安量化机器人.Modules.Alert.AlertCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1F2937" Padding="16" CornerRadius="8" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="🚨 预警与通知中心" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                
                <Button Content="➕ 新建预警"
                        Height="36"
                        Padding="16,0"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        Click="CreateAlert_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>

        <!-- 预警统计卡片 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 活跃预警 -->
            <Border Grid.Column="0" Background="White" 
                    BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="活跃预警" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="ActiveAlertsText" 
                               Text="0 个" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="#10B981"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 今日触发 -->
            <Border Grid.Column="2" Background="White" 
                    BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="今日触发" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="TodayTriggeredText" 
                               Text="0 次" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 通知方式 -->
            <Border Grid.Column="4" Background="White" 
                    BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="通知方式" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="NotificationMethodsText" 
                               Text="系统通知" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 暂停状态 -->
            <Border Grid.Column="6" Background="White" 
                    BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="全局状态" FontSize="12" Foreground="#6B7280"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox x:Name="GlobalEnableCheckBox"
                                  Content="启用预警"
                                  IsChecked="True"
                                  FontWeight="Bold"
                                  Checked="GlobalEnable_Changed"
                                  Unchecked="GlobalEnable_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tab切换 -->
        <TabControl Grid.Row="2" 
                    Background="White"
                    BorderThickness="0">
            
            <!-- Tab 1: 价格预警 -->
            <TabItem Header="💰 价格预警" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 操作栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="➕ 新建价格预警"
                                    Height="32"
                                    Padding="12,0"
                                    Background="#3B82F6"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="CreatePriceAlert_Click"
                                    Cursor="Hand"/>
                        </StackPanel>

                        <!-- 价格预警列表 -->
                        <DataGrid Grid.Row="1" 
                                  x:Name="PriceAlertsGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1"
                                  BorderBrush="#E5E7EB"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F9FAFB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="交易对" Binding="{Binding Symbol}" Width="100"/>
                                <DataGridTextColumn Header="条件" Binding="{Binding Condition}" Width="120"/>
                                <DataGridTextColumn Header="触发价格" Binding="{Binding TriggerPrice, StringFormat=F2}" Width="120"/>
                                <DataGridTextColumn Header="当前价格" Binding="{Binding CurrentPrice, StringFormat=F2}" Width="120"/>
                                <DataGridTextColumn Header="差距" Binding="{Binding Distance}" Width="100"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                                <DataGridTemplateColumn Header="操作" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="删除" 
                                                        Height="28" 
                                                        Padding="8,0"
                                                        Margin="0,0,4,0"
                                                        Background="#EF4444"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Click="DeletePriceAlert_Click"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 2: 持仓预警 -->
            <TabItem Header="📊 持仓预警" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="持仓风险预警" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,16"/>

                            <!-- 预警规则列表 -->
                            <ItemsControl x:Name="PositionAlertsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" 
                                                BorderBrush="#E5E7EB" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="16" 
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 图标 -->
                                                <Border Grid.Column="0" 
                                                        Background="{Binding IconBackground}"
                                                        CornerRadius="8"
                                                        Width="48"
                                                        Height="48"
                                                        Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Icon}" 
                                                               FontSize="24" 
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- 规则信息 -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding AlertName}" 
                                                               FontSize="16" 
                                                               FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}" 
                                                               FontSize="12" 
                                                               Foreground="#6B7280"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding CurrentStatus}" 
                                                               FontSize="13" 
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- 开关 -->
                                                <CheckBox Grid.Column="2" 
                                                          IsChecked="{Binding IsEnabled}"
                                                          VerticalAlignment="Center"
                                                          Content="启用"
                                                          FontSize="13"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 3: 通知历史 -->
            <TabItem Header="📋 通知历史" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 筛选栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="通知类型:" 
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="NotificationTypeFilter" 
                                      Width="150" 
                                      Height="32"
                                      SelectionChanged="NotificationTypeFilter_Changed">
                                <ComboBoxItem Content="全部" IsSelected="True"/>
                                <ComboBoxItem Content="价格预警"/>
                                <ComboBoxItem Content="持仓预警"/>
                                <ComboBoxItem Content="系统通知"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 通知历史列表 -->
                        <DataGrid Grid.Row="1" 
                                  x:Name="NotificationHistoryGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1"
                                  BorderBrush="#E5E7EB"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F9FAFB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding NotificationType}" Width="100"/>
                                <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="80"/>
                                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="200"/>
                                <DataGridTextColumn Header="消息内容" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 4: 通知设置 -->
            <TabItem Header="⚙️ 通知设置" FontSize="14" Padding="12,8">
                <Border Background="White" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="通知方式配置" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,16"/>

                            <!-- 系统通知 -->
                            <Border Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="💻 系统通知" 
                                                   FontSize="16" 
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"/>
                                        <CheckBox Content="启用"
                                                  IsChecked="True"
                                                  HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock Text="通过Windows系统通知栏推送消息" 
                                               FontSize="12" 
                                               Foreground="#6B7280"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 邮件通知 -->
                            <Border Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="📧 邮件通知" 
                                                   FontSize="16" 
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"/>
                                        <CheckBox x:Name="EmailEnableCheckBox"
                                                  Content="启用"
                                                  HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    
                                    <TextBlock Text="邮箱地址" FontSize="12" Foreground="#6B7280" Margin="0,12,0,4"/>
                                    <TextBox x:Name="EmailAddressInput" 
                                             Height="32" 
                                             Text="example@email.com"
                                             IsEnabled="{Binding ElementName=EmailEnableCheckBox, Path=IsChecked}"/>
                                    
                                    <Button Content="发送测试邮件"
                                            Height="32"
                                            Margin="0,8,0,0"
                                            Click="SendTestEmail_Click"
                                            IsEnabled="{Binding ElementName=EmailEnableCheckBox, Path=IsChecked}"/>
                                </StackPanel>
                            </Border>

                            <!-- Telegram通知 -->
                            <Border Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="📱 Telegram通知" 
                                                   FontSize="16" 
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"/>
                                        <CheckBox x:Name="TelegramEnableCheckBox"
                                                  Content="启用"
                                                  HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    
                                    <TextBlock Text="Bot Token" FontSize="12" Foreground="#6B7280" Margin="0,12,0,4"/>
                                    <TextBox x:Name="TelegramTokenInput" 
                                             Height="32"
                                             IsEnabled="{Binding ElementName=TelegramEnableCheckBox, Path=IsChecked}"/>
                                    
                                    <TextBlock Text="Chat ID" FontSize="12" Foreground="#6B7280" Margin="0,8,0,4"/>
                                    <TextBox x:Name="TelegramChatIdInput" 
                                             Height="32"
                                             IsEnabled="{Binding ElementName=TelegramEnableCheckBox, Path=IsChecked}"/>
                                    
                                    <Button Content="发送测试消息"
                                            Height="32"
                                            Margin="0,8,0,0"
                                            Click="SendTestTelegram_Click"
                                            IsEnabled="{Binding ElementName=TelegramEnableCheckBox, Path=IsChecked}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
