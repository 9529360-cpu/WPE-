<UserControl x:Class="币安量化机器人.Modules.Paper.PaperTradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1F2937" Padding="16" CornerRadius="8" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="📝 AI模拟交易中心" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#059669" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟢" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusIndicator" 
                                       Text="就绪" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       Foreground="White" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 控制面板 + 账户信息 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 账户控制 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" 
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="账户控制" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    
                    <!-- 账户选择 -->
                    <TextBlock Text="当前账户" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <ComboBox x:Name="AccountTypeCombo" Height="36" FontSize="14" Margin="0,0,0,12">
                        <ComboBoxItem Content="💰 模拟账户" IsSelected="True"/>
                        <ComboBoxItem Content="💵 真实账户 (未激活)" IsEnabled="False"/>
                    </ComboBox>

                    <!-- 监控品种 -->
                    <TextBlock Text="监控品种" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <TextBox x:Name="SymbolsInput" 
                             Height="36" 
                             Text="BTCUSDT,ETHUSDT"
                             FontSize="14"
                             Margin="0,0,0,12"/>

                    <!-- AI交易控制 -->
                    <Button x:Name="StartAIButton"
                            Content="🚀 启动AI自动交易"
                            Height="48"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#10B981"
                            Foreground="White"
                            BorderThickness="0"
                            Click="StartAI_Click"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="8"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#059669"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="StopAIButton"
                            Content="⏹ 停止AI交易"
                            Height="40"
                            FontSize="14"
                            Background="#EF4444"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,8,0,0"
                            Click="StopAI_Click"
                            IsEnabled="False"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="8"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 中: 账户概览 -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" 
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="账户概览" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    
                    <!-- 净值 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="账户净值" FontSize="12" Foreground="#6B7280" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="NetValueText" 
                                   Text="10,000.00 USDT" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- 可用余额 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="可用余额" FontSize="12" Foreground="#6B7280" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="AvailableBalanceText" 
                                   Text="10,000.00 USDT" 
                                   FontSize="14"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- 持仓市值 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="持仓市值" FontSize="12" Foreground="#6B7280" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="PositionValueText" 
                                   Text="0.00 USDT" 
                                   FontSize="14"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Separator Margin="0,8"/>

                    <!-- 今日盈亏 -->
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="今日盈亏" FontSize="12" Foreground="#6B7280" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TodayPnLText" 
                                   Text="+0.00 (+0.00%)" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#22C55E"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- 总盈亏 -->
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="总盈亏" FontSize="12" Foreground="#6B7280" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TotalPnLText" 
                                   Text="+0.00 (+0.00%)" 
                                   FontSize="14"
                                   Foreground="#22C55E"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 右: 交易统计 -->
            <Border Grid.Column="4" Background="White" BorderBrush="#E5E7EB" 
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="交易统计" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    
                    <!-- 持仓数量 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="持仓数量" FontSize="12" Foreground="#6B7280" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="PositionCountText" 
                                   Text="0 个" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- 交易次数 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="交易次数" FontSize="12" Foreground="#6B7280" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TotalTradesText" 
                                   Text="0 笔" 
                                   FontSize="14"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- 胜率 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="胜率" FontSize="12" Foreground="#6B7280" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="WinRateText" 
                                   Text="0%" 
                                   FontSize="14"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Separator Margin="0,8"/>

                    <!-- 盈利次数 -->
                    <DockPanel Margin="0,8,0,4">
                        <TextBlock Text="盈利" FontSize="12" Foreground="#22C55E" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="WinningTradesText" 
                                   Text="0 笔" 
                                   FontSize="13"
                                   Foreground="#22C55E"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- 亏损次数 -->
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="亏损" FontSize="12" Foreground="#EF4444" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="LosingTradesText" 
                                   Text="0 笔" 
                                   FontSize="13"
                                   Foreground="#EF4444"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 持仓列表 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" 
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="📊 当前持仓" 
                               FontSize="16" 
                               FontWeight="Bold"
                               DockPanel.Dock="Left"/>
                    
                    <Button Content="🔄 刷新"
                            Height="32"
                            Padding="12,0"
                            HorizontalAlignment="Right"
                            Click="RefreshPositions_Click"/>
                </DockPanel>

                <DataGrid Grid.Row="1" 
                          x:Name="PositionsGrid" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F9FAFB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="交易对" Binding="{Binding Symbol}" Width="120"/>
                        <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="80"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Quantity, StringFormat=F4}" Width="120"/>
                        <DataGridTextColumn Header="开仓价" Binding="{Binding EntryPrice, StringFormat=F2}" Width="120"/>
                        <DataGridTextColumn Header="当前价" Binding="{Binding CurrentPrice, StringFormat=F2}" Width="120"/>
                        <DataGridTextColumn Header="未实现盈亏" Binding="{Binding UnrealizedPnL, StringFormat=F2}" Width="140"/>
                        <DataGridTextColumn Header="盈亏%" Binding="{Binding PnLPercent, StringFormat=P2}" Width="100"/>
                        <DataGridTextColumn Header="持仓时长" Binding="{Binding HoldingHours, StringFormat=F1}" Width="100"/>
                        <DataGridTemplateColumn Header="操作" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="平仓" 
                                            Height="28" 
                                            Padding="12,0"
                                            Background="#EF4444"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="ClosePosition_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 交易日志 -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" 
                BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="📋 AI交易日志 (最近10条)" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="0,4">
                                    <TextBlock Text="{Binding}" 
                                               FontSize="12" 
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
