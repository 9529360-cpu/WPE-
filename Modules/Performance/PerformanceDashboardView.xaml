<UserControl x:Class="币安量化机器人.Modules.Performance.PerformanceDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:performance="clr-namespace:币安量化机器人.Modules.Performance"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400">
    <UserControl.DataContext>
        <performance:PerformanceDashboardViewModel />
    </UserControl.DataContext>

    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏（专业精简版） -->
        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题与状态 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="绩效分析仪表盘" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 账户选择（保留必要交互） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="账户" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="160" Height="32"
                              ItemsSource="{Binding AccountTypes}"
                              SelectedItem="{Binding AccountType, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <!-- 关键指标卡片（自适应布局） -->
                <ItemsControl ItemsSource="{Binding CoreKpis}" Margin="0,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" Margin="0,0,12,12" Width="210">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding ValueText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0" Foreground="{Binding ValueBrush}"/>
                                    <TextBlock Text="{Binding SubText}" FontSize="11" Margin="0,4,0,0" Foreground="{Binding SubBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 净值曲线图 -->
                <Border Background="White" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="400"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="净值曲线" FontSize="15" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12"/>
                        <ScottPlot:WpfPlot x:Name="EquityPlot" Grid.Row="1" Background="White"/>
                    </Grid>
                </Border>

                <!-- 其余区域后续 MVVM 化，先保持精简 -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
