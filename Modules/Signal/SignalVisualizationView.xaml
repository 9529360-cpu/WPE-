<UserControl x:Class="币安量化机器人.Modules.Signal.SignalVisualizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    
    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="24,20" 
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📡" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="交易信号监控" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock x:Name="StatusText" Text="实时监控 AI 交易信号" 
                                   FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 统计卡片 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                           HorizontalAlignment="Center" Margin="40,0">
                    <!-- 今日信号数 -->
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="今日信号" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TodaySignalsText" Text="0" 
                                       FontSize="24" FontWeight="Bold" Foreground="#1E40AF" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 执行率 -->
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="执行率" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ExecutionRateText" Text="0%" 
                                       FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 平均置信度 -->
                    <Border Background="#FEF3C7" CornerRadius="8" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="平均置信度" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AvgConfidenceText" Text="0%" 
                                       FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="FilterButton" Content="🔍 筛选" 
                            Width="90" Height="36" Margin="0,0,8,0"
                            Background="#F3F4F6" Foreground="#374151"
                            BorderBrush="#D1D5DB" BorderThickness="1"
                            FontSize="13" FontWeight="SemiBold"
                            Click="Filter_Click"/>
                    
                    <Button x:Name="ClearButton" Content="🗑️ 清空" 
                            Width="90" Height="36" Margin="0,0,8,0"
                            Background="#FEE2E2" Foreground="#DC2626"
                            BorderBrush="#FCA5A5" BorderThickness="1"
                            FontSize="13" FontWeight="SemiBold"
                            Click="Clear_Click"/>
                    
                    <Button x:Name="RefreshButton" Content="🔄 刷新" 
                            Width="90" Height="36"
                            Background="#3B82F6" Foreground="White"
                            BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold"
                            Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧: 信号列表 -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" 
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 列表标题 -->
                    <Border Grid.Row="0" Background="#F9FAFB" Padding="20,16"
                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="📊 实时信号流" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock x:Name="SignalCountText" Text="(0 条)" 
                                       FontSize="13" Foreground="#6B7280"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 信号列表 -->
                    <DataGrid x:Name="SignalsGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="60"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionChanged="SignalsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <!-- 时间 -->
                            <DataGridTextColumn Header="时间" Width="80" Binding="{Binding DisplayTime}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 交易对 -->
                            <DataGridTextColumn Header="交易对" Width="100" Binding="{Binding Symbol}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#111827"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 动作 -->
                            <DataGridTemplateColumn Header="信号" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ActionColor}" 
                                                CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding Action}" 
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 置信度 -->
                            <DataGridTemplateColumn Header="置信度" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ConfidenceText}" 
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding ConfidenceColor}"/>
                                            <ProgressBar Value="{Binding ConfidencePercent}" 
                                                         Height="4" Margin="0,4,0,0"
                                                         Foreground="{Binding ConfidenceColor}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 入场价 -->
                            <DataGridTextColumn Header="入场价" Width="100" Binding="{Binding EntryPriceText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#111827"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 目标价 -->
                            <DataGridTextColumn Header="目标价" Width="100" Binding="{Binding TargetPriceText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#10B981"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 止损价 -->
                            <DataGridTextColumn Header="止损价" Width="100" Binding="{Binding StopLossText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 风险收益比 -->
                            <DataGridTextColumn Header="R/R" Width="60" Binding="{Binding RiskRewardText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#8B5CF6"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 右侧: 信号详情 -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" 
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!-- 详情标题 -->
                        <TextBlock Text="📋 信号详情" FontSize="16" FontWeight="Bold" 
                                   Foreground="#111827" Margin="0,0,0,16"/>

                        <!-- 基本信息 -->
                        <Border Background="#F9FAFB" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="基本信息" FontSize="13" FontWeight="SemiBold" 
                                           Foreground="#6B7280" Margin="0,0,0,8"/>
                                
                                <TextBlock x:Name="DetailSymbol" Text="交易对: -" 
                                           FontSize="13" Foreground="#111827" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailAction" Text="动作: -" 
                                           FontSize="13" Foreground="#111827" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailTimeframe" Text="时间框架: -" 
                                           FontSize="13" Foreground="#111827" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailRiskLevel" Text="风险等级: -" 
                                           FontSize="13" Foreground="#111827"/>
                            </StackPanel>
                        </Border>

                        <!-- 价格信息 -->
                        <Border Background="#F9FAFB" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="价格目标" FontSize="13" FontWeight="SemiBold" 
                                           Foreground="#6B7280" Margin="0,0,0,8"/>
                                
                                <TextBlock x:Name="DetailEntry" Text="入场价: -" 
                                           FontSize="13" Foreground="#111827" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailTarget" Text="目标价: -" 
                                           FontSize="13" Foreground="#10B981" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailStopLoss" Text="止损价: -" 
                                           FontSize="13" Foreground="#EF4444" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailPositionSize" Text="仓位: -" 
                                           FontSize="13" Foreground="#111827"/>
                            </StackPanel>
                        </Border>

                        <!-- 分析理由 -->
                        <Border Background="#FEF3C7" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💡 AI 分析理由" FontSize="13" FontWeight="SemiBold" 
                                           Foreground="#D97706" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DetailReason" Text="暂无详情" 
                                           FontSize="12" Foreground="#92400E" 
                                           TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- 技术指标 -->
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="📊 技术指标" FontSize="13" FontWeight="SemiBold" 
                                           Foreground="#3B82F6" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DetailIndicators" Text="暂无数据" 
                                           FontSize="12" Foreground="#1E40AF" 
                                           TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
