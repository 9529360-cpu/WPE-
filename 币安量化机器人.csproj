<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<UseWPF>true</UseWPF>

		<!-- 代码质量（按需留） -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Disable auto-generation of assembly attributes to avoid duplicate attribute errors during publish/run in test harness -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- Prevent SDK from emitting TargetFrameworkAttribute (duplicate when WPF temp project also emits it) -->
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<!-- Suppress raw string literal indentation compiler error when mixed content exists in legacy files -->
		<NoWarn>8999</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <None Include=".github\upgrades\change-log.md" />
	</ItemGroup>

    <ItemGroup>
      <PackageReference Include="LiteDB" Version="5.0.21" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
      <PackageReference Include="ScottPlot" Version="5.1.57" />
      <PackageReference Include="ScottPlot.WPF" Version="5.0.55" />
      <PackageReference Include="Binance.Net" Version="11.11.0" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
      <PackageReference Include="Serilog" Version="4.3.0" />
      <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
      <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
      <!-- Ensure runtime binding for System.Text.Json 9.x used by configuration packages -->
      <PackageReference Include="System.Text.Json" Version="10.0.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
      <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
      <PackageReference Include="Polly" Version="8.6.4" />
	<PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
      <!-- 可选：SourceLink（如果你需要）
  <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  -->
    </ItemGroup>

    <ItemGroup>
      <None Update="Data\\ai\\lstm_model.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
