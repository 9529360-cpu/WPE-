<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<UseWPF>true</UseWPF>

		<!-- 代码质量（按需留） -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- 防止与手动 AssemblyInfo.cs 冲突 -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<!-- 项目仅在 Windows 上运行，忽略 Windows 平台互操作性规则 CA1416 -->
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ScottPlot.WPF" Version="5.0.56" />
      <PackageReference Include="Binance.Net" Version="8.3.0" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.4" />
      <PackageReference Include="Serilog" Version="2.12.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
      <PackageReference Include="Serilog.Extensions.Logging" Version="3.1.0" />
      <!-- 可选：SourceLink（如果你需要）
  <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  -->
    </ItemGroup>

    <ItemGroup>
      <None Update="Data\ai\lstm_model.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <!-- Exclude test sources placed under repository tests/ or Tests/ from main project compilation -->
    <ItemGroup>
      <Compile Remove="tests\**\*.cs" />
      <Compile Remove="Tests\**\*.cs" />
      <None Remove="tests\**\*.*" />
      <None Remove="Tests\**\*.*" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Tools\IntegrationChecker\" />
    </ItemGroup>

    <ItemGroup>
      <None Include=".github\workflows\dotnet.yml" />
    </ItemGroup>

</Project>
